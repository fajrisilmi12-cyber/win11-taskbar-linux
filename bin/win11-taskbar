#!/usr/bin/env python3
"""
Win11 Taskbar for Linux (Arch / Debian / Fedora)
A native, lightweight Windows 11 Taskbar & Start Menu dock for any Linux desktop.
Reads XML configuration and connects to native Linux apps.
"""
import os
import sys
import subprocess
import json
import xml.etree.ElementTree as ET
import threading
import time
import shutil
import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import Gtk, Gdk, WebKit2, GLib

# Search paths for configuration
CONFIG_DIRS = [
    os.path.expanduser("~/.config/win11-taskbar"),
    "/etc/win11-taskbar",
    "/usr/share/win11-taskbar"
]

def find_file(filename):
    for d in CONFIG_DIRS:
        p = os.path.join(d, filename)
        if os.path.exists(p):
            return p
    # Fallback to local directory
    local = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "share", filename)
    if os.path.exists(local):
        return local
    return filename

LAYOUT_XML = find_file("TaskbarLayout.xml")
INDEX_HTML = find_file("index.html")

def find_terminal():
    for t in ["xfce4-terminal", "gnome-terminal", "konsole", "alacritty", "kitty", "foot", "xterm"]:
        if shutil.which(t):
            return t
    return "xterm"

class Win11TaskbarWindow(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Windows 11 Taskbar")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        
        # Make taskbar stick to bottom of screen across all workspaces
        self.stick()
        
        # Screen size handling
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        geom = monitor.get_geometry()
        
        # Transparent background support
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)
        self.set_app_paintable(True)
        
        # Set full screen overlay to allow floating start menu & flyouts
        self.set_default_size(geom.width, geom.height)
        self.move(geom.x, geom.y)
        
        self.taskbar_apps, self.pinned_apps, self.recom_items = self.load_layout()
        
        # WebKit Settings
        settings = WebKit2.Settings()
        settings.set_enable_write_console_messages_to_stdout(True)
        settings.set_allow_file_access_from_file_urls(True)
        settings.set_allow_universal_access_from_file_urls(True)
        settings.set_enable_javascript(True)
        
        content_mgr = WebKit2.UserContentManager()
        content_mgr.register_script_message_handler("win11shell")
        content_mgr.connect("script-message-received::win11shell", self.on_js_message)
        
        self.webview = WebKit2.WebView.new_with_user_content_manager(content_mgr)
        self.webview.set_settings(settings)
        self.webview.set_background_color(Gdk.RGBA(0, 0, 0, 0)) # Fully transparent WebKit
        self.webview.connect("load-changed", self.on_load_changed)
        
        if os.path.exists(INDEX_HTML):
            self.webview.load_uri(f"file://{os.path.abspath(INDEX_HTML)}")
        else:
            self.webview.load_html("<h1>Error: Taskbar HTML not found</h1>")
            
        self.add(self.webview)
        self.connect("destroy", Gtk.main_quit)
        
        # Start running process tracker
        threading.Thread(target=self.track_processes_loop, daemon=True).start()

    def load_layout(self):
        tb_apps = []
        pinned_apps = []
        recom_items = []
        if os.path.exists(LAYOUT_XML):
            try:
                tree = ET.parse(LAYOUT_XML)
                root = tree.getroot()
                ns = {'w': 'http://schemas.microsoft.com/Start/2014/LayoutModification'}
                for app in root.findall('.//w:TaskbarPinList/w:App', ns):
                    tb_apps.append({
                        "id": app.get("id", ""),
                        "name": app.get("name", ""),
                        "exec": app.get("exec", ""),
                        "icon": app.get("icon", "")
                    })
                for app in root.findall('.//w:PinnedList/w:App', ns):
                    pinned_apps.append({
                        "name": app.get("name", ""),
                        "exec": app.get("exec", ""),
                        "icon": app.get("icon", ""),
                        "category": app.get("category", "")
                    })
                for it in root.findall('.//w:RecommendedList/w:Item', ns):
                    recom_items.append({
                        "name": it.get("name", ""),
                        "time": it.get("time", ""),
                        "type": it.get("type", "")
                    })
            except Exception as e:
                print("XML parse error:", e)
        return tb_apps, pinned_apps, recom_items

    def track_processes_loop(self):
        known_patterns = {
            "aircrack": ["aircrack-ng", "airodump-ng", "airmon-ng"],
            "wireshark": ["wireshark", "tshark"],
            "nmap": ["nmap"],
            "metasploit": ["msfconsole"],
            "bettercap": ["bettercap"],
            "sqlmap": ["sqlmap"],
            "john": ["john"],
            "hashcat": ["hashcat"],
            "burp": ["burpsuite"],
            "responder": ["responder"],
            "terminal": ["xfce4-terminal", "gnome-terminal", "konsole", "alacritty", "kitty", "foot", "xterm"],
            "explorer": ["thunar", "nautilus", "dolphin", "pcmanfm"],
            "edge": ["chromium", "google-chrome", "firefox"]
        }
        while True:
            try:
                out = subprocess.check_output(["ps", "-eo", "comm,args"], text=True).lower()
                running_keys = []
                for key, pats in known_patterns.items():
                    for p in pats:
                        if p in out:
                            running_keys.append(key)
                            break
                GLib.idle_add(self.update_running_status, running_keys)
            except Exception:
                pass
            time.sleep(1.5)

    def update_running_status(self, running_keys):
        js = f"if(window.updateRunningApps) window.updateRunningApps({json.dumps(running_keys)});"
        self.webview.run_javascript(js, None, None, None)
        return False

    def on_load_changed(self, webview, event):
        if event == WebKit2.LoadEvent.FINISHED:
            data = {
                "taskbar": self.taskbar_apps,
                "pinned": self.pinned_apps,
                "recommended": self.recom_items
            }
            js = f"if(window.loadXMLData) window.loadXMLData({json.dumps(data)});"
            self.webview.run_javascript(js, None, None, None)

    def on_js_message(self, content_mgr, js_result):
        msg = js_result.get_js_value().to_string()
        try:
            obj = json.loads(msg)
            action = obj.get("action")
            cmd = obj.get("exec")
            term = find_terminal()
            
            if action == "exec" and cmd:
                if "terminal" in cmd and not shutil.which("xfce4-terminal"):
                    cmd = cmd.replace("xfce4-terminal", term)
                subprocess.Popen(cmd, shell=True)
                
            elif action == "terminal":
                subprocess.Popen([term])
                
            elif action == "file-manager":
                fm = shutil.which("thunar") or shutil.which("nautilus") or shutil.which("dolphin") or "xdg-open ."
                subprocess.Popen(fm, shell=True)
                
            elif action in {"task-manager", "taskbar-settings", "wifi", "bluetooth", "audio", "network", "calendar", "user-settings"}:
                commands = {
                    "task-manager": ["xfce4-taskmanager", "gnome-system-monitor", "htop"],
                    "taskbar-settings": ["xfce4-settings-manager", "gnome-control-center"],
                    "wifi": ["nm-connection-editor", "nmtui"],
                    "bluetooth": ["blueman-manager", "gnome-control-center bluetooth"],
                    "audio": ["pavucontrol", "alsamixer"],
                    "network": ["nm-connection-editor", "nmtui"],
                    "calendar": ["orage", "gnome-calendar", "cal"],
                    "user-settings": ["xfce4-settings-manager", "gnome-control-center user-accounts"]
                }
                for c in commands.get(action, []):
                    bin_name = c.split()[0]
                    if shutil.which(bin_name):
                        if c in {"htop", "nmtui", "alsamixer", "cal"}:
                            subprocess.Popen([term, "-e", c])
                        else:
                            subprocess.Popen(c, shell=True)
                        break
            elif action == "power":
                opt = obj.get("option")
                if opt == "shutdown":
                    subprocess.Popen("systemctl poweroff", shell=True)
                elif opt == "restart":
                    subprocess.Popen("systemctl reboot", shell=True)
        except Exception as e:
            print("Action error:", e)

if __name__ == "__main__":
    win = Win11TaskbarWindow()
    win.show_all()
    Gtk.main()
